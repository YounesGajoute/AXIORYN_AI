# Use Node 24.3 or newer. The server reads environment variables, not this file.
HOST=127.0.0.1
PORT=3000
AXIORYN_DB=data/axioryn.db

# Optional AI. Disabled unless enabled, with both a key and model configured.
# Set secrets in your process environment. Never commit real credentials.
AXIORYN_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AXIORYN_AI_MAX_OUTPUT_TOKENS=1500
AXIORYN_AI_DAILY_REQUEST_LIMIT=10
